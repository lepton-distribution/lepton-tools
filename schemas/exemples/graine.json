{
  "$schema": "../graine.schema.json",
  "projet": {
    "nom": "tauon-basic",
    "version": "1.0.0",
    "description": "Système de base Lepton sur NUCLEO-F429ZI."
  },
  "noyau": "lepton-noyau",
  "bsp": "nucleo-f429zi",
  "applications": [
    "mesure"
  ],
  "bibliotheques": [
    "capteurs"
  ],
  "backend": "embos",
  "configurations": [
    {
      "nom": "debug-carte",
      "construction": "Debug",
      "execution": "carte"
    },
    {
      "nom": "release-carte",
      "construction": "Release",
      "execution": "carte"
    }
  ],
  "mklepton_xml": "sys/user/tauon-basic/etc/mkconf_tauon_basic_nucleo_f429zi.xml",
  "options": {
    "lepton-noyau": {
      "LEPTON_KAL_TRACE": true
    },
    "mesure": {
      "MESURE_PERIODE_MS": 500
    },
    "capteurs": {
      "CAPTEURS_UNITE": "brut"
    }
  }
}
